{
  "type": "object",
  "properties": {
    "answer": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WireImage"
      },
      "description": "Images attached to the answer; only honoured when the request had \u0007cceptsImages."
    }
  },
  "required": [
    "answer"
  ],
  "title": "QuestionResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "WireImage": {
      "type": "object",
      "properties": {
        "mediaType": {
          "type": "string",
          "description": "`image/png`, `image/jpeg`, `image/gif` or `image/webp`."
        },
        "base64": {
          "type": "string"
        }
      },
      "required": [
        "mediaType",
        "base64"
      ]
    }
  }
}
