{
  "type": "object",
  "properties": {
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RecalledSteeringMessage"
      }
    }
  },
  "title": "RecallSteeringResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "RecalledSteeringMessage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "enqueuedAt": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WireImage"
          },
          "description": "The message's images, in order. Recall is the one place the payload\nis handed back; queue status only ever carries metadata.",
          "default": []
        }
      },
      "required": [
        "id",
        "text"
      ]
    },
    "WireImage": {
      "type": "object",
      "properties": {
        "mediaType": {
          "type": "string",
          "description": "`image/png`, `image/jpeg`, `image/gif` or `image/webp`."
        },
        "base64": {
          "type": "string"
        }
      },
      "required": [
        "mediaType",
        "base64"
      ]
    }
  }
}
